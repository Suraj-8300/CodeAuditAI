#!/usr/bin/env python3
import sys
import os

project_root = os.path.dirname(os.path.realpath(__file__))
venv_python = os.path.realpath(os.path.join(project_root, ".venv", "bin", "python3"))

# Automatically switch to project's .venv Python if invoked via system Python
# Enforce absolute boundary containment within project_root (CWE-426)
if os.path.exists(venv_python) and venv_python.startswith(project_root):
    if os.path.realpath(sys.executable) != venv_python:
        os.execv(venv_python, [venv_python] + sys.argv)

# Ensure project root is in sys.path
if project_root not in sys.path:
    sys.path.insert(0, project_root)

from app.cli import main

if __name__ == "__main__":
    sys.exit(main())
